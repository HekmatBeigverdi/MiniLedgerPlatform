{
  "name": "miniledgerplatform",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @miniledgerplatform/web dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @miniledgerplatform/web build",
    "lint": "turbo run lint",
    "lint:web": "pnpm --filter @miniledgerplatform/web lint",
    "format": "turbo run format",
    "build:web:desktop": "pnpm --filter @miniledgerplatform/web build:desktop",
    "dev:desktop": "pnpm --filter @miniledgerplatform/desktop dev",
    "build:desktop": "pnpm --filter @miniledgerplatform/desktop build"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
