{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-temp",
  "version": "0.1.0",
  "identifier": "com.greedydev.desktop-temp",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --dir ../web build:desktop",
    "frontendDist": "../web/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "desktop-temp",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
