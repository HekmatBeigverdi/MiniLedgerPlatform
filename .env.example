# MiniLedgerPlatform environment variables

# Public application metadata
NEXT_PUBLIC_APP_NAME=MiniLedgerPlatform
NEXT_PUBLIC_APP_DESCRIPTION="A web-first and desktop-ready accounting platform."

# Public web app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API base URL
# This is planned for future backend integration.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Runtime mode
NEXT_PUBLIC_APP_MODE=web